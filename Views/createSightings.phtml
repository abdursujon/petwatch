        (<?= htmlspecialchars($pet['species']) ?>)
       </option>
      <?php endforeach; ?>
     </select>
    </div>

    <!--Show selected pet image-->
    <?php if ($selectedPet && !empty($selectedPet['photo_url'])): ?>
     <div class="mb-3 text-left">
      <img src="<?= htmlspecialchars($selectedPet['photo_url']) ?>"
