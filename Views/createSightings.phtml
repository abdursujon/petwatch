             required onchange="this.form.submit()">
      <option value="" disabled <?= $selectedPetId ? '' : 'selected' ?>>
       --Choose a pet--
      </option>
      <!--Loop through all pets-->
      <?php foreach ($view->pets as $pet): ?>
       <option value="<?= htmlspecialchars($pet['id']) ?>"
               <?= ($selectedPetId == $pet['id']) ? 'selected' : '' ?>>
