 <!-- Pagination -->
 <?php if ($view->totalPages > 1): ?>
  <nav aria-label="Pagination" class="mt-4">
   <ul class="pagination justify-content-center">
    <!-- Query string for pagination and filter links
         This ensures when navigating between different view page,
         current search, filter, and sort options remain applied
    -->
    <?php
    $queryParams = [];

    // Add the search term to the query if provided by usr
    if (!empty($view->searchTerm))
     $queryParams[] = 'search=' . urlencode($view->searchTerm);
    // Add selected status filer if provided by user
    if (!empty($view->filters['status']))
     $queryParams[] = 'filter_status=' . urlencode($view->filters['status']);
    // add selected species if provided by user
    if (!empty($view->filters['species']))
     $queryParams[] = 'filter_species=' . urlencode($view->filters['species']);
    // add the filter oldest or latest to the query
    if (!empty($view->sort)) {
     if (in_array($view->sort, ['latest', 'oldest'])) {
      $queryParams[] = 'sort_date=' . urlencode($view->sort);
     } else {
      $queryParams[] = 'sort_order=' . urlencode($view->sort);
     }
    }

    //combine all query parameters into a single URL string which
    // allows to keep all th filter
    // & allow us to do this in all pagination pages
    $queryString = !empty($queryParams)
     ? implode('&', $queryParams) . '&'
     : '';
    // Define the base URL which handle the logic (controller viewSightings.php)
    $baseUrl = 'viewSightings.php?' . $queryString;
    ?>

    <!-- Previous -->
    <li class="page-item <?= ($view->page <= 1) ? 'disabled' : '' ?>">
     <!--If current page is more than one, activate previous button-->
     <?php if ($view->page > 1): ?>
      <a class="page-link"
         href="<?= $baseUrl ?>page=<?= $view->page - 1 ?>">&laquo; Previous</a>
     <?php else: ?>
      <span class="page-link">&laquo; Previous</span>
     <?php endif; ?>
    </li>

    <!-- Page Numbers calculation-->
    <?php
    // Determine which page to display around the current page
    // (up to two before and after)
    $start = max(1, $view->page - 2);
    $end = min($view->totalPages, $view->page + 2);
    //Loop through the range and render the page number
    for ($i = $start; $i <= $end; $i++):
     $active = ($i == $view->page) ? 'active' : '';
    ?>
     <li class="page-item <?= $active ?>">
      <!--Display the active page number and make it non-clickable -->
      <?php if ($active): ?>
       <span class="page-link"><?= $i ?></span>
      <!-- Display other page numbers as clickable links -->
      <?php else: ?>
       <a class="page-link" href="<?= $baseUrl ?>page=<?= $i ?>"><?= $i ?></a>
      <?php endif; ?>
     </li>
    <?php endfor; ?>

    <!-- Next button for pagination -->
    <li class="page-item <?= ($view->page >= $view->totalPages) ? 'disabled' : '' ?>">
     <!-- If the current page is not the last one, enable the next button-->
     <?php if ($view->page < $view->totalPages): ?>
      <a class="page-link"
         href="<?= $baseUrl ?>page=<?= $view->page + 1 ?>">Next &raquo;</a>
     <?php else: ?>
      <span class="page-link">Next &raquo;</span>
     <?php endif; ?>
    </li>
   </ul>
  </nav>
 <?php endif; ?>
