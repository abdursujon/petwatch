<script>
  const allPets = <?= json_encode($view->pets) ?>;
  const searchInput = document.getElementById('pet-search');
  const resultsDiv = document.getElementById('pet-search-results');
  const hiddenInput = document.getElementById('selected-pet-id');
  const preview = document.getElementById('selected-pet-preview');

  searchInput.addEventListener('input', () => {
    let query = searchInput.value.trim().toLowerCase();
    resultsDiv.innerHTML = '';

    if (query.length < 1) return;

    let matches = allPets.filter(p =>
      p.name.toLowerCase().includes(query) ||
      p.species.toLowerCase().includes(query)
    );

    matches.forEach(pet => {
      let item = document.createElement('div');
      item.className = 'pet-search-item';
      item.innerHTML = `
          <img src="${pet.photo_url}" alt="${pet.name}"/>
          <div>
            <strong>#${pet.id} - ${pet.name}</strong>
            <small>${pet.species}</small>
          </div>
        `;
      item.addEventListener('click', () => {
        hiddenInput.value = pet.id;
        searchInput.value = pet.name;
        resultsDiv.innerHTML = '';
        preview.innerHTML = `
            <div class="d-flex align-items-center gap-3 p-2 border rounded">
              <img src="${pet.photo_url}" alt="${pet.name}" class="rounded"
                   style="width: 60px; height: 60px; object-fit: cover;">
              <div>
                <strong>#${pet.id} - ${pet.name}</strong>
                <br><small class="text-muted">${pet.species}</small>
              </div>
            </div>
          `;
      });
      resultsDiv.appendChild(item);
    });
  });

  document.addEventListener('click', (e) => {
    if (!searchInput.contains(e.target) && !resultsDiv.contains(e.target)) {
      resultsDiv.innerHTML = '';
    }
  });
</script>

